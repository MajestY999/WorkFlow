{
  "name": "workflow",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:seed": "node --env-file=.env --import tsx server/scripts/seed.ts",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.3",
    "bcryptjs": "^3.0.3",
    "nuxt": "^4.0.0",
    "pg": "^8.23.1",
    "pinia": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint-plugin-vue": "^10.11.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.14"
  }
}
